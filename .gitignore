# agent-harness:project-gitignore:v1:start
# Managed block. Its source is .agents/templates/gitignore in the harness repository; edit it
# there and re-run EnsureProject. Anything you add outside these markers is preserved.

# Task-hook runtime state. hook-state.js writes <repo-root>/taskstate/<project-id>/ by its own
# design -- session-local records, allow-tag usage among them -- which belong to one device and
# one session rather than to the project. It was never ignored, so every project running the
# hooks accumulated an untracked directory in its root that a `git add -A` would commit.
taskstate/

# The pre-relocation location for the same state. A session that predates the move still writes
# here, so a project can acquire this directory without any current tool creating it.
.claude/state/
# agent-harness:project-gitignore:v1:end

# Allowlist .gitignore: ignore everything at the repo root, then re-include ONLY the
# shippable files. New scratch (_verify_*.js, _shots_*.js, _cloud_items.json, results, etc.)
# is ignored by default — you must add a keeper here on purpose. Re-including a directory
# tracks its contents, since git recurses into an un-ignored directory.

/*

# --- Keeper directories (all contents are keepers) ---
!/api/
!/public/
!/test/
!/scripts/
!/.agents/
!/.cursor/
!/.github/

# --- Keeper root files ---
!/.gitignore
!/.gitattributes
!/.env.example
!/.nvmrc
!/package.json
!/package-lock.json
!/README.md
!/RESUME.md
!/SPEC.md
!/CODEX.md
!/sync.js
!/sync-cloud.js
!/local-server.js
!/enqueue.js
!/consolidate-projects.js
!/migrate-local.js
!/cleanup-data.js
!/import-outbox.js
!/docket-cli.js
!/docket.ps1
!/docket-daemon.js
!/docket-daemon.vbs
!/sync-review.cmd
!/_sync_once.cmd
!/.gitleaks.toml
!/AGENTS.md
!/CLAUDE.md
!/STATUS.md
!/LOG.md
!/BACKBURNER.md
!/TASK.md
!/MAP.md
!/DESIGN.md
!/MEMORY.md
!/data-manifest.yaml
!/secret-manifest.json
!/secret-manifest.md
!/skills-manifest.json

# --- Belt-and-suspenders (these win over any re-include above; keep secrets/bulk out even
#     if someone later adds a stray !re-include) ---

# Secrets / credentials, by name.
.env
.env.*
!.env.example
.passcode.txt

# Deploy state (holds sensitive Vercel project IDs) + tool state.
.vercel/
.impeccable/

# Regenerable / bulk (re-obtainable via `npm ci`, re-runnable from the _shots_*.js scripts).
node_modules/
_shots/
_backups/
*.log

# Session task-state locks.
*.md.lock.json
