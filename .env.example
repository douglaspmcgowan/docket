# Copy to .env and fill in. The real .env is gitignored.
# Load it into your shell before running the scripts (e.g. `set -a; . ./.env; set +a`),
# or export the vars directly. No values below are real.

# --- Cloud board (sync.js, enqueue.js, migrate-local.js, cleanup-data.js) ---
# Your Vercel deploy URL.
REVIEW_URL=https://your-app.vercel.app
# The shared passcode / bearer secret. Alternatively put it in .passcode.txt (gitignored).
REVIEW_SECRET=
# The Vercel app reads the same secret under this name (set in Vercel env, not locally).
APP_SECRET=

# --- Vercel Blob (cloud store; injected automatically by Vercel, set only for local cloud tests) ---
BLOB_READ_WRITE_TOKEN=

# --- Local mirror (local-server.js) ---
# HTTP port for the local NASA-safe mirror.
PORT=8471
# Where the local file store lives. Defaults to ~/.docket-local when unset.
LOCAL_STORE_DIR=
# Directory the /api/artifact route serves legacy critique images from.
# Defaults to ../ai-for-cad/cad-forge/shots/audit relative to the repo when unset.
ARTIFACT_DIR=

# --- docket-daemon ---
# Sync interval in ms (default 900000 = 15 min).
DOCKET_SYNC_MS=900000
# Full path to node.exe if it is not on PATH (used by docket-daemon.vbs).
DOCKET_NODE=

# --- test / verify helpers ---
LOCAL_URL=http://127.0.0.1:8471
START_PATH=/
